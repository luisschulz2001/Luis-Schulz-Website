# Öffentliche Adresse der Website (für SEO, Sitemap, Sprachverweise)
NEXT_PUBLIC_SITE_URL=https://www.luisschulz.de

# --- Kontaktformular (Resend, https://resend.com) ---
RESEND_API_KEY=
# Absender – Domain muss in Resend verifiziert sein
CONTACT_FROM_EMAIL="Website Luis Schulz <kontakt@luisschulz.de>"
# Optional: Empfänger je Anliegen (sonst die Adressen aus dem CMS)
CONTACT_TO_COACHING=
CONTACT_TO_PARTNERS=
CONTACT_TO_PRESS=
CONTACT_TO_GENERAL=

# --- Keystatic CMS online (GitHub-Modus) ---
# Lokal leer lassen → Änderungen landen direkt in /content
NEXT_PUBLIC_KEYSTATIC_STORAGE=
# Werden beim Einrichten von Keystatic automatisch erzeugt:
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
